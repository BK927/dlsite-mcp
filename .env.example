MCP_TRANSPORT=stdio
HOST=0.0.0.0
PORT=8080
MCP_PATH=/mcp
HEALTH_PATH=/healthz
HTTP_MAX_BODY_BYTES=2097152

# Required for remote HTTP unless unauthenticated mode is explicitly enabled.
MCP_ACCESS_TOKEN=
MCP_ALLOW_UNAUTHENTICATED=false
PUBLIC_BASE_URL=
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Personal ChatGPT OAuth. Use three distinct random secrets.
MCP_OAUTH_ENABLED=false
MCP_OAUTH_ISSUER=
MCP_OAUTH_RESOURCE=
MCP_OAUTH_SCOPE=dlsite.read
MCP_OAUTH_LOGIN_SECRET=
MCP_OAUTH_SIGNING_SECRET=
MCP_OAUTH_STORE=memory
MCP_OAUTH_CODE_COLLECTION=dlsite_oauth_codes
GCP_PROJECT=

# Compact result, cache, and upstream controls.
DLSITE_CURSOR_SECRET=
DLSITE_CURSOR_TTL_SECONDS=86400
DLSITE_MAX_RESULT_BYTES=12288
DLSITE_CACHE_MAX_ENTRIES=256
DLSITE_CACHE_TTL_SECONDS=600
DLSITE_TIMEOUT_SECONDS=25
